From ff67b0088ff6fce0ade7e269d891271cc4bf6576 Mon Sep 17 00:00:00 2001
From: wnduddld0513 <wnduddld0513@users.noreply.github.com>
Date: Wed, 7 Oct 2026 11:29:51 +0900
Subject: [PATCH] kernel: Skip the vendor_dlkm install when no modules are left

kernel.mk installs every built module that is not in
SYSTEM_KERNEL_MODULES to vendor_dlkm, even an empty set, which
overwrote modules.dep and modules.load of prebuilt vendor modules and
failed on their load list. Skip it when nothing is left.

Change-Id: Ie939d3d5c7ca6853b687c3757eb90c5ad0727fc2
---
 build/tasks/kernel.mk | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/build/tasks/kernel.mk b/build/tasks/kernel.mk
index 04c6cad..88d94ed 100644
--- a/build/tasks/kernel.mk
+++ b/build/tasks/kernel.mk
@@ -570,7 +570,9 @@ $(TARGET_PREBUILT_INT_KERNEL): $(KERNEL_CONFIG) $(DEPMOD) $(DTC) $(KERNEL_MODULE
 					module_name=$$(basename $$n); \
 					if [[ ! "$(SYSTEM_KERNEL_MODULES)" =~ "$$module_name" ]]; then echo $$n; fi; \
 				done); \
-				($(call build-image-kernel-modules-lineage,$$filtered_modules,$(KERNEL_MODULES_OUT),$(KERNEL_MODULE_MOUNTPOINT)/,$(KERNEL_DEPMOD_STAGING_DIR),$(BOARD_VENDOR_KERNEL_MODULES_LOAD),,$(KERNEL_MODULES_PARTITION_FILE_LIST),$(SYSTEM_KERNEL_DEPMOD_STAGING_DIR)/lib/modules/0.0/$(SYSTEM_KERNEL_MODULE_MOUNTPOINT))) || exit "$$?"; \
+				if [ -n "$$filtered_modules" ]; then \
+					($(call build-image-kernel-modules-lineage,$$filtered_modules,$(KERNEL_MODULES_OUT),$(KERNEL_MODULE_MOUNTPOINT)/,$(KERNEL_DEPMOD_STAGING_DIR),$(BOARD_VENDOR_KERNEL_MODULES_LOAD),,$(KERNEL_MODULES_PARTITION_FILE_LIST),$(SYSTEM_KERNEL_DEPMOD_STAGING_DIR)/lib/modules/0.0/$(SYSTEM_KERNEL_MODULE_MOUNTPOINT))) || exit "$$?"; \
+				fi; \
 				if grep -q 'CONFIG_MODULE_SIG_FORMAT=y' $(KERNEL_CONFIG); then \
 					(for m in $$(find $(SYSTEM_KERNEL_MODULES_OUT) -type f -name "*.ko"); do \
 						$(KERNEL_OUT)/scripts/sign-file sha1 \
-- 
2.43.0

