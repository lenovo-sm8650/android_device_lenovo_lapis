# Display
persist.settings.large_screen_opt.enabled=true

# App handle -> split screen. The prebuilt Pixel Launcher reads
# config_isDesktopModeSupported by Google's framework resource ID (0x011101f3),
# which is config_hideNavBarForKeyboard (false) in the PixelOS framework, so it
# never registered its split-select listener. With device restrictions off it
# skips that resource check (desktop mode stays limited to what the config
# and flags already allow on this device).
persist.wm.debug.desktop_mode_enforce_device_restrictions=false

# Default color mode Adaptive (see config_availableColorModes in the overlay)
persist.sys.sf.native_mode=2

# Device type for the stock Lenovo apps (PenService, keyboard updaters,
# ZuiUDevice, ZuiNotes). Stock init copies ro.vendor.config.lgsi.device.type
# (vendor.prop: pad) here through /system/etc/init/lgsi_prop.cfg; our init does
# not. Their bundled zui library (CommonUtils.isPadProduct) reads it: without
# it MessageDialog/ActionDialog/AlertActivity fall back to the phone landscape
# placement, docked bottom-right with a clipped height, instead of the centred
# tablet dialogs. Only this key, not the rest of ro.config.lgsi.* (vendor.prop).
ro.config.lgsi.device.type=pad

# Brightness slider like stock ZUI: linear instead of the AOSP HLG gamma curve.
# Stock maps the slider with brightness = a*s^2 + b*s + c (ro.sys.zui.param.*,
# a=1e-10, b=0.15259, c=0 on the 0-65535 slider, i.e. linear), so 50% on the
# slider is 50% backlight; HLG gives about 8%, which made 30-70% look much
# darker than on ZUI while the peak was the same. AOSP SettingsLib has the
# switch for this; label: sepolicy/private/property_contexts.
sys.brightness.disable_gamma_conversion=true

# Desktop mode keeps the home screen (icons, widgets) behind the freeform windows and the
# launcher shows its pinned desktop taskbar on the desktop-first display. Without these AOSP
# shows only the desktop wallpaper (config_showHomeBehindDesktop and
# config_enterDesktopByDefaultOnFreeformDisplay are false and not overlaid). The properties,
# not the resources, because the prebuilt Pixel Launcher reads Google's framework resource
# IDs (see persist.wm.debug.desktop_mode_enforce_device_restrictions above); the WM Shell and
# the launcher read the same properties first (DesktopStateImpl, DesktopModeStatus).
persist.wm.debug.show_home_behind_desktop=true
persist.wm.debug.enter_desktop_by_default_on_freeform_display=true
