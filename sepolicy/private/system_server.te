# PixelOS properties system_server reads (PropImitationHooks in the
# framework, the version for the updater) but device/custom only grants to
# apps.
get_prop(system_server, pih_disable_prop)
get_prop(system_server, custom_version_prop)

# tb520fu-input BatteryController: a Lenovo charge limit holds charging
set_prop(system_server, tb520fu_charge_hold_prop)
