# Services published by lenovo-input (hardware/lenovo/input) in system_server for the
# stock Lenovo PenService: pen writing haptics and ZUI notifications.
type zui_pen_haptic_service, app_api_service, system_server_service, service_manager_type;
type zui_notification_service, app_api_service, system_server_service, service_manager_type;
# Raw keyboard access for the platform-signed firmware updater (stock: same type)
type zui_keyboard_manager_service, system_server_service, service_manager_type;
# Keybox attestation signing service (KeyboxAttestationService in system_server).
# app_api_service: the app-process keystore hook binder-calls the internal signing
# entry; the service itself gates by caller uid / target list.
type keybox_attestation_service, app_api_service, system_server_service, service_manager_type;
