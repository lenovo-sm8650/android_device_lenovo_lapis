# persist.vendor.sys.fp.* (Goodix fingerprint HAL)
vendor_internal_prop(vendor_fp_prop)

# ro.vendor.config.lgsi.* (vendor.prop): Lenovo device/pen identity read by
# PenService, ZuiUDevice and other Lenovo apps
vendor_public_prop(vendor_lenovo_config_prop)

# ro.vendor.tb520fu.dtb_region: package variant (PRC / ROW), read by the updater
vendor_public_prop(vendor_tb520fu_region_prop)

# Dolby Vision
vendor_internal_prop(vendor_dolbyv_prop)

# ro.odm.lenovo.* set by the stock Lenovo odm build.prop (stock label)
vendor_internal_prop(vendor_lenovotb_init_prop)
set_prop(vendor_init, vendor_lenovotb_init_prop)
