# power_supply/wls_tx is the pen/keyboard wireless charging transmitter, not a
# charger input. Leaving it unreadable keeps BatteryService from reporting
# "wireless powered".
dontaudit hal_health_default sysfs:file { read open getattr };
dontaudit hal_health_default vendor_sysfs_wls_tx:dir r_dir_perms;
dontaudit hal_health_default vendor_sysfs_wls_tx:file r_file_perms;

# vendor.tb520fu.charge_hold: a Lenovo charge limit holds charging (health/main.cpp)
get_prop(hal_health_default, vendor_tb520fu_charge_hold_prop)
