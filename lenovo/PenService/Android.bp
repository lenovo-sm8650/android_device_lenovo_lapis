//
// Stock Lenovo PenService (pen settings, buttons, writing haptics UI, EasyJot)
// with a compat dex prepended for ZUI / Android 14 APIs absent in Android 17.
// Handwriting settings link to Gboard; the duplicate Lenovo IME service is
// removed from the manifest by tb520fu_prepend_dex. The stock APK comes from the vendor tree
// (proprietary-files.txt: EXTRACT_ONLY, FILEGROUP PenService-stock), hence the
// own namespace importing it (the vendor namespace already imports the
// device one). Listed in PRODUCT_SOONG_NAMESPACES in device.mk.
//

soong_namespace {
    imports: ["vendor/lenovo/lapis"],
}

java_library {
    name: "PenServiceCompatStubs",
    srcs: ["stubs/**/*.java"],
    platform_apis: true,
    installable: false,
}

java_library {
    name: "PenServiceCompat",
    srcs: ["src/**/*.java"],
    libs: ["PenServiceCompatStubs"],
    platform_apis: true,
    installable: false,
}

python_binary_host {
    name: "tb520fu_prepend_dex",
    main: "prepend_dex.py",
    srcs: ["prepend_dex.py"],
}

java_genrule {
    name: "PenService-compat-apk",
    srcs: [
        ":PenServiceCompat",
        ":PenService-stock",
    ],
    tools: [
        "d8",
        "tb520fu_prepend_dex",
    ],
    out: ["PenService.apk"],
    cmd: "$(location d8) --release --no-desugaring --min-api 35 " +
        "--output $(genDir)/compat.zip $(location :PenServiceCompat) && " +
        "$(location tb520fu_prepend_dex) --apk $(location :PenService-stock) " +
        "--dex-zip $(genDir)/compat.zip --remove-pen-ime --out $(out)",
}

prebuilt_etc {
    name: "privapp-permissions-com.lenovo.penservice.xml",
    src: "privapp-permissions-com.lenovo.penservice.xml",
    sub_dir: "permissions",
    system_ext_specific: true,
}

android_app_import {
    name: "PenService",
    required: ["privapp-permissions-com.lenovo.penservice.xml"],
    apk: ":PenService-compat-apk",
    certificate: "platform",
    privileged: true,
    system_ext_specific: true,
    dex_preopt: {
        enabled: false,
    },
}
