<?xml version="1.0" encoding="utf-8"?>
<!-- Display configuration of the built-in panel of the Lenovo Yoga Tab Plus.

     The backlight scale (0 to 1) is the one of Android, with the high brightness
     mode of the panel on top: up to 0.85 the normal range of the panel (the
     brightness curve of the previous configuration, 650 nits at the end), above
     it the range with the "hbm" node of the panel on, up to 900 nits (typical and
     peak brightness of the specifications of the panel). LenovoHbmBridge sends it
     as the "hbm" node and a backlight value of the composer. -->
<displayConfiguration>
    <name>Lenovo TB520FU LCD</name>

    <screenBrightnessMap>
        <point><value>0.000830</value><nits>7.91434</nits></point>
        <point><value>0.010039</value><nits>8.0</nits></point>
        <point><value>0.036811</value><nits>30.0</nits></point>
        <point><value>0.087008</value><nits>70.0</nits></point>
        <point><value>0.127165</value><nits>100.0</nits></point>
        <point><value>0.153937</value><nits>120.0</nits></point>
        <point><value>0.194094</value><nits>150.0</nits></point>
        <point><value>0.234252</value><nits>180.0</nits></point>
        <point><value>0.271063</value><nits>210.0</nits></point>
        <point><value>0.351378</value><nits>270.0</nits></point>
        <point><value>0.441732</value><nits>340.0</nits></point>
        <point><value>0.548819</value><nits>420.0</nits></point>
        <point><value>0.625787</value><nits>480.0</nits></point>
        <point><value>0.719488</value><nits>550.0</nits></point>
        <point><value>0.850000</value><nits>650.0</nits></point>
        <point><value>1.000000</value><nits>900.0</nits></point>
    </screenBrightnessMap>
    <screenBrightnessDefault>0.2862</screenBrightnessDefault>

    <!-- Sunlight: like the stock firmware (5000 lux, brightness at the maximum), for
         the usual time of Android. HDR video does not use this time, only the thermal
         limits of the device. -->
    <highBrightnessMode enabled="true">
        <transitionPoint>0.85</transitionPoint>
        <minimumLux>5000</minimumLux>
        <timing>
            <timeWindowSecs>1800</timeWindowSecs>
            <timeMaxSecs>300</timeMaxSecs>
            <timeMinSecs>60</timeMinSecs>
        </timing>
        <allowInLowPowerMode>false</allowInLowPowerMode>
        <minimumHdrPercentOfScreen>0.25</minimumHdrPercentOfScreen>
        <sdrHdrRatioMap>
            <point><sdrNits>2.0</sdrNits><hdrRatio>8.0</hdrRatio></point>
            <point><sdrNits>300.0</sdrNits><hdrRatio>3.0</hdrRatio></point>
            <point><sdrNits>650.0</sdrNits><hdrRatio>1.38</hdrRatio></point>
        </sdrHdrRatioMap>
    </highBrightnessMode>

    <!-- HDR content raises the backlight above the SDR brightness, up to the maximum
         of the high brightness mode, and the SDR layers are dimmed to keep their
         brightness. No limit by the ambient light: the limit is the one for the first
         lux above the last point, and below the SDR brightness it would dim the screen
         when the video starts. -->
    <hdrBrightnessConfig>
        <brightnessMap>
            <point><first>100000</first><second>1.0</second></point>
        </brightnessMap>
        <brightnessIncreaseDebounceMillis>500</brightnessIncreaseDebounceMillis>
        <brightnessDecreaseDebounceMillis>3000</brightnessDecreaseDebounceMillis>
        <screenBrightnessRampIncrease>0.5</screenBrightnessRampIncrease>
        <screenBrightnessRampDecrease>0.3</screenBrightnessRampDecrease>
        <minimumHdrPercentOfScreenForNbm>0.25</minimumHdrPercentOfScreenForNbm>
        <minimumHdrPercentOfScreenForHbm>0.25</minimumHdrPercentOfScreenForHbm>
        <allowInLowPowerMode>false</allowInLowPowerMode>
        <sdrHdrRatioMap>
            <point><first>2.0</first><second>8.0</second></point>
            <point><first>300.0</first><second>3.0</second></point>
            <point><first>650.0</first><second>1.38</second></point>
        </sdrHdrRatioMap>
    </hdrBrightnessConfig>
</displayConfiguration>
