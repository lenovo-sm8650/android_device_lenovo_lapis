    <name>Lenovo TB520FU LCD</name>

    <screenBrightnessMap>
        <point><value>0.000830</value><nits>7.91434</nits></point>
        <point><value>0.010039</value><nits>8.0</nits></point>
        <point><value>0.036811</value><nits>30.0</nits></point>
        <point><value>0.087008</value><nits>70.0</nits></point>
        <point><value>0.127165</value><nits>100.0</nits></point>
        <point><value>0.153937</value><nits>120.0</nits></point>
        <point><value>0.194094</value><nits>150.0</nits></point>
        <point><value>0.234252</value><nits>180.0</nits></point>
        <point><value>0.271063</value><nits>210.0</nits></point>
        <point><value>0.351378</value><nits>270.0</nits></point>
        <point><value>0.441732</value><nits>340.0</nits></point>
        <point><value>0.548819</value><nits>420.0</nits></point>
        <point><value>0.625787</value><nits>480.0</nits></point>
        <point><value>0.719488</value><nits>550.0</nits></point>
        <point><value>0.850000</value><nits>650.0</nits></point>
        <point><value>1.000000</value><nits>900.0</nits></point>
    </screenBrightnessMap>
    <screenBrightnessDefault>0.2862</screenBrightnessDefault>

    <highBrightnessMode enabled="true">
        <transitionPoint>0.85</transitionPoint>
        <!-- Sunlight: like the stock firmware and the Pixel (auto brightness, above
             5000 lux), for the usual time of Android (5 minutes in 30). HDR video does
             not use this time, only the thermal limits of the device. -->
        <minimumLux>5000</minimumLux>
        <timing>
            <timeWindowSecs>1800</timeWindowSecs>
            <timeMaxSecs>300</timeMaxSecs>
            <timeMinSecs>60</timeMinSecs>
        </timing>
        <allowInLowPowerMode>false</allowInLowPowerMode>
        <minimumHdrPercentOfScreen>0.1</minimumHdrPercentOfScreen>
        <sdrHdrRatioMap>
